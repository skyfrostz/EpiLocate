# EpiLocate remote GPU Worker runtime template.
# This file contains no credential. Materialize a private, mode-0600 runtime
# env file outside Git and inject TOKEN from the approved secret store.
# The GPU-side SSH tunnel must be established before starting python -m worker.

WORKER_ID=node_gpu_replace_me
BACKEND_URL=https://127.0.0.1:9443
MODEL_VERSION=548b39b9a799a4cbf56982c569d752c2e37ce4ac005089b0339a6194a3cad734
MODEL_HASH=548b39b9a799a4cbf56982c569d752c2e37ce4ac005089b0339a6194a3cad734
EPILOCATE_FROZEN_ROOT=/mnt/epilocate/frozen/FROZEN_RELEASE
WORKER_DATA_ROOT=/mnt/epilocate/worker-data
WORKER_CA_CERT=/mnt/epilocate/tls/control-plane-ca.pem
WORKER_DEVICE=CUDA
WORKER_POLL_SECONDS=5

# TOKEN is intentionally absent. It must be supplied only in the private
# runtime environment or a separate 0600 file and must never be committed,
# placed in a URL, or written to logs.
