[Unit]
Description=EpiLocate MVP Backend v2
After=network-online.target postgresql.service epilocate-minio.service
Wants=network-online.target
Requires=epilocate-minio.service

[Service]
Type=simple
User=epilocate-backend
Group=epilocate-backend
WorkingDirectory=/opt/epilocate-mvp/current
EnvironmentFile=/etc/epilocate-mvp/backend.env
ExecStart=/opt/epilocate-mvp/current/.venv/bin/uvicorn backend_v2.api.app:app --host 127.0.0.1 --port 8890 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
