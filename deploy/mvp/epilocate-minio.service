[Unit]
Description=EpiLocate MVP private MinIO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=epilocate-minio
Group=epilocate-minio
EnvironmentFile=/etc/epilocate-mvp/minio.env
ExecStart=/usr/local/bin/minio server /var/lib/epilocate-mvp/minio --address 127.0.0.1:59000 --console-address 127.0.0.1:59001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/epilocate-mvp/minio

[Install]
WantedBy=multi-user.target
