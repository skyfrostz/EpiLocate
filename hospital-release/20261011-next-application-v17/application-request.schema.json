  "required": [
    "schema_version",
    "algorithm_mode",
    "method_mode",
    "algorithm_version",
    "config_sha256",
    "execution_mode",
    "input",
    "model",
    "task",
    "budget"
  ],
  "title": "ApplicationRequest",
  "type": "object"
}
