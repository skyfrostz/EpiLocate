# Copy to a deployment-managed environment file. Do not commit real credentials.

# Backend / PostgreSQL 16
EPILOCATE_V2_DATABASE_URL=postgresql+psycopg://epilocate:change-me@postgres:5432/epilocate
EPILOCATE_V2_DB_POOL_SIZE=5
EPILOCATE_V2_DB_MAX_OVERFLOW=10
EPILOCATE_V2_DB_POOL_RECYCLE_SECONDS=1800
EPILOCATE_V2_LEASE_SECRET=replace-with-at-least-32-random-characters
# Production uses database-backed credentials provisioned by the command below.
# Set true only for isolated local bootstrap tests; never enable in production.
EPILOCATE_V2_ALLOW_ENV_TOKENS=false
EPILOCATE_V2_USER_TOKEN_HASHES={}

# Private S3-compatible storage / MinIO
EPILOCATE_V2_S3_ENDPOINT=http://minio:9000
# Browser-reachable endpoint used only to sign URLs; use an HTTPS public hostname in deployment.
EPILOCATE_V2_S3_PUBLIC_ENDPOINT=http://127.0.0.1:59000
EPILOCATE_V2_S3_REGION=us-east-1
EPILOCATE_V2_S3_BUCKET=epilocate-private
EPILOCATE_V2_S3_ACCESS_KEY=change-me
EPILOCATE_V2_S3_SECRET_KEY=change-me
EPILOCATE_V2_S3_ADDRESSING_STYLE=path
EPILOCATE_V2_S3_SERVER_SIDE_ENCRYPTION=false
DICOM_RETENTION_DAYS=7

# AI Worker v1 (load this section only in the Worker process)
WORKER_ID=node_replace-after-provisioning
BACKEND_URL=https://backend.example.com
TOKEN=replace-with-provisioned-worker-bearer
MODEL_VERSION=548b39b9a799a4cbf56982c569d752c2e37ce4ac005089b0339a6194a3cad734
EPILOCATE_FROZEN_ROOT=/srv/epilocate/frozen-readonly
WORKER_DATA_ROOT=/srv/epilocate/worker-data
WORKER_POLL_SECONDS=5

# Frontend build-time endpoint (set in the Frontend deployment, never a secret)
VITE_API_BASE_URL=https://backend.example.com/api/v2
