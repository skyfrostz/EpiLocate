# Browser uses the same-origin v2 route. No token is included in the browser bundle.
VITE_API_BASE_URL=/api/v2
# Local Vite server proxy only. Keep these values in ignored .env.local.
# API_PROXY_TARGET=http://127.0.0.1:8890
# API_PROXY_USER_TOKEN=<a locally provisioned user token, never a Worker token>
