APP_MODE=mock
APP_HOST=127.0.0.1
APP_PORT=8000
APP_MAX_UPLOAD_MIB=20
APP_MAX_IMAGE_PIXELS=50000000
# Set an absolute read-only root containing the frozen checkpoint and protocol.
EPILOCATE_FROZEN_ROOT=
# Set a separate writable runtime directory outside outputs/experiments.
APP_DATA_ROOT=
# Legacy PNG/JPG v0.1 pipeline hook; not used by real DICOM P0 endpoints.
REAL_PIPELINE_MODULE=algorithm.inference_pipeline
REAL_PIPELINE_CALLABLE=run_case
